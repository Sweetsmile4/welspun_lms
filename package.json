{
  "name": "welspun-lms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "backend",
    "backend/worker",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @welspun/api",
    "dev:worker": "npm run dev -w @welspun/worker",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mongo": "vitest run backend/test/organization.mongo.test.ts backend/test/authorization.mongo.test.ts backend/test/http-security.mongo.test.ts backend/test/management.mongo.test.ts backend/test/security-hardening.mongo.test.ts backend/test/security-performance.mongo.test.ts backend/test/course.mongo.test.ts backend/test/publishing.mongo.test.ts backend/test/catalog.mongo.test.ts backend/test/integration-storage.mongo.test.ts backend/test/session-transport-foundation.mongo.test.ts",
    "test:mongo:local": "node scripts/test-mongo-local.mjs",
    "setup:integration:local": "tsx scripts/setup-integration-local.ts",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run smoke:worker",
    "smoke:worker": "npm run start -w @welspun/worker",
    "dev": "npm run dev:api",
    "start": "npm run start -w @welspun/api",
    "build:lambda": "npm run build:lambda -w @welspun/api && node scripts/smoke-lambda.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
