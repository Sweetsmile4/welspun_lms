NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
IDENTITY_MODE=disabled
ISOLATED_DEVELOPMENT=false
# Remains disabled in Phase 1A. No connection occurs on import or startup.
DATABASE_ENABLED=false
# Legacy disposable-local configuration only; not an alias for shared Atlas keys.
# Never paste production credentials into examples.
# MONGODB_URI=mongodb://127.0.0.1:27017/welspun_lms_dev_synthetic?replicaSet=localdev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
# A URI alone never connects. Explicit isolated local commands must also opt in.

# Future shared Atlas integration only: exact approved keys, backend-only.
# These do not activate the foundation API/worker or the disposable test adapter.
# Leave URI blank here; supply secrets only through an approved backend channel later.
MONGOURI=
DATABASE_NAME=welspun_lms_dev
