NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
IDENTITY_MODE=disabled
ISOLATED_DEVELOPMENT=false
# Remains disabled in Phase 1A. No connection occurs on import or startup.
DATABASE_ENABLED=false
# Legacy disposable-local configuration only; not an alias for shared Atlas keys.
# Never paste production credentials into examples.
# MONGODB_URI=mongodb://127.0.0.1:27017/welspun_lms_dev_synthetic?replicaSet=localdev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
# A URI alone never connects. Explicit isolated local commands must also opt in.

# Future shared Atlas integration only: exact approved keys, backend-only.
# Set DATABASE_ENABLED=true only with the approved backend secret channel.
MONGOURI=mongodb+srv://user:password@cluster.example/welspun_lms_dev
DATABASE_NAME=welspun_lms_dev

# Read-only public synthetic demo assignments. No accounts or persisted learning records.
DEMO_API_ENABLED=false
# Use hosted only for a deliberately network-accessible listener; Lambda needs no listener.
DEPLOYMENT_MODE=local

LMS_LIVE_ENABLED=false
LMS_REGISTRATION_ENABLED=false
LMS_FRONTEND_ORIGIN=http://127.0.0.1:3000

# Optional Windows-only system DNS compatibility; no public resolver override.
LMS_WINDOWS_SYSTEM_DNS=false
